NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
CUSTOMER_API_PORT=4010

# MySQL local. Thay CHANGE_ME bằng mật khẩu thật trên từng máy.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smartres_staff
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME

REDIS_URL=redis://127.0.0.1:6379
AI_SERVICE_URL=http://127.0.0.1:8000

# Chỉ đặt khi có domain/IP cố định. Để trống thì script QR tự tìm IPv4 LAN.
NEXT_PUBLIC_WEB_URL=

SMARTRES_AUTH_SECRET=change-this-local-secret
JWT_SECRET=change-this-local-secret
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
