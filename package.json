{
  "name": "smartres",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:customer": "npm --workspace apps/api run db:staff && npm --workspace apps/api run db:customer && npm run generate:qr",
    "dev:customer": "node scripts/dev-customer.mjs",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:customer-api": "npm --workspace apps/api run dev:customer",
    "generate:qr": "npm --workspace apps/api run qr:tables",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "lint:web": "npm --workspace apps/web run lint",
    "typecheck": "npm --workspace apps/api run typecheck && npm --workspace apps/web run typecheck"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4"
  }
}
