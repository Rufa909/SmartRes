{
  "name": "@smartres/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:staff": "node scripts/setup-staff-db.mjs",
    "db:customer": "node scripts/setup-customer-db.mjs",
    "db:invoices": "tsx scripts/setup-invoices.ts",
    "qr:tables": "node scripts/generate-table-qrs.mjs",
    "dev:staff": "tsx watch src/staff-server.ts",
    "dev:customer": "tsx watch src/server.ts",
    "test:staff": "tsx --test scripts/staff.integration.test.ts",
    "test:customer-security": "tsx --test scripts/customer-security.integration.test.ts",
    "test:menu": "tsx --test scripts/menu-management.integration.test.ts",
    "test:overview": "tsx --test scripts/management-overview.integration.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "mysql2": "^3.11.5",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

